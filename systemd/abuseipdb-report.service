[Unit]
Description=fail2ban -> AbuseIPDB asynchronous reporter
Documentation=file:/etc/abuseipdb/reporter.conf
After=network-online.target fail2ban.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/abuseipdb-report
Nice=10
IOSchedulingClass=idle

# Hardening: the worker only needs to read two SQLite files, write the queue,
# the log and the status file, and talk TCP over IPv4/IPv6.
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

# Queue, report journal, status file and log; /run holds the instance lock.
ReadWritePaths=/var/lib/abuseipdb /var/log /run
