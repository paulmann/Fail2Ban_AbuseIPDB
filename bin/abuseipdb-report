#!/usr/bin/env python3
"""Drain the local queue into AbuseIPDB (run from a systemd timer or cron)."""
import os
import sys

sys.dont_write_bytecode = True  # keep /usr/local/lib clean (no __pycache__)

_HERE = os.path.dirname(os.path.abspath(__file__))
for _candidate in (
    os.path.normpath(os.path.join(_HERE, "..", "lib")),  # /usr/local/sbin -> /usr/local/lib
    "/usr/local/lib",
    os.path.normpath(os.path.join(_HERE, "..", "src")),  # git checkout -> src/
):
    if os.path.isdir(os.path.join(_candidate, "abuseipdb_reporter")):
        sys.path.insert(0, _candidate)
        break

from abuseipdb_reporter.cli import main_report  # noqa: E402

if __name__ == "__main__":
    sys.exit(main_report())